DATABASE_URL=sqlite+aiosqlite:///./data/bizibox.db
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000"]
SECRET_KEY=dev-secret-key-not-for-production
DEBUG=false
ENCRYPTION_KEY=dev-encryption-key-not-for-production
# Смена HOST на 0.0.0.0 требует auth и HTTPS — см. docs/architecture/06-final-review-report.md (R2-16)
HOST=127.0.0.1
PORT=7910
ENVIRONMENT=development
# Сгенерируйте свои на https://my.telegram.org/apps
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_POLL_INTERVAL=10
EMAIL_POLL_INTERVAL=60
# Прокси для Telegram нужен ТОЛЬКО если нет системного VPN (OpenVPN/WireGuard)
# и Telegram недоступен напрямую. Укажите локальный адрес прокси-приложения
# (v2rayN/Clash/Nekoray), напр. socks5 127.0.0.1:10808.
# Системный VPN прокси НЕ требует — оставьте ENABLED=False и пустые host/port.
TELEGRAM_PROXY_ENABLED=False
TELEGRAM_PROXY_TYPE=socks5
TELEGRAM_PROXY_HOST=
TELEGRAM_PROXY_PORT=
TELEGRAM_PROXY_USERNAME=
TELEGRAM_PROXY_PASSWORD=

# VK (ВКонтакте) — канал сообщений
# 1. Создайте сообщество на vk.com и включите «Сообщения сообщества».
# 2. «Управление» → «Работа с API» → «Ключи доступа» → создайте ключ с правом «Сообщения сообщества».
# 3. Включите Long Poll API и событие «Входящее сообщение».
VK_GROUP_ID=0
VK_ACCESS_TOKEN=your_vk_access_token_here
VK_2FA_PASSWORD=
VK_POLL_INTERVAL=10
